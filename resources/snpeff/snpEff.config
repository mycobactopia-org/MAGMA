#-------------------------------------------------------------------------------
# SnpEff configuration file — MAGMA pipeline
# Supports M. tuberculosis H37Rv and M. bovis AF2122/97A
#-------------------------------------------------------------------------------

#---
# Database files are stored here (relative to this config file)
#---
data.dir = ./data/

#---
# Download options
#---
download.timeout = 60

#---
# M. tuberculosis H37Rv
# Standard SnpEff genome ID used when running without -profile mbovis
# NOTE: If running outside a container that has this DB pre-installed, download with:
#   snpEff download Mycobacterium_tuberculosis_h37rv
#---
Mycobacterium_tuberculosis_h37rv.genome : Mycobacterium_tuberculosis_h37rv
Mycobacterium_tuberculosis_h37rv.chromosomes : Chromosome
Mycobacterium_tuberculosis_h37rv.Chromosome.codonTable : Bacterial_and_Plant_Plastid

#---
# M. bovis AF2122/97A
# Used when running with -profile mbovis (snpeff_genome_id = "mbovis_AF2122")
# DB files: resources/snpeff/data/mbovis_AF2122/genes.gff + sequences.fa
# Built at runtime via: snpEff build -c snpEff.config -gff3 -v mbovis_AF2122
#---
mbovis_AF2122.genome : Mycobacterium_bovis_AF2122_97
mbovis_AF2122.chromosomes : Chromosome
mbovis_AF2122.Chromosome.codonTable : Bacterial_and_Plant_Plastid
