/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Full pipeline test using 3 complete M. tuberculosis H37Rv samples from the
    EXIT-RIF cohort (PRJNA1026351), downloaded directly from EBI FTP.

    Sample depths (from SRA):
        SRR26331590: ~1.9M read pairs  (~82x coverage)
        SRR26331595: ~7.7M read pairs  (~331x coverage)
        SRR26331599: ~3.4M read pairs  (~147x coverage)

    Enables all downstream analyses (phylogeny, clustering, drug resistance
    profiling, structural variants). Expected runtime: 2-4 h depending on
    hardware.

    NOTE: Requires ~16 CPUs and ~64 GB RAM. Not suitable for laptop/CI runs.
          Use -profile test for fast CI checks with subsampled data.

    Use as follows:
        nextflow run TORCH-consortium/magma -profile test_full,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Full pipeline test: 3 M. tuberculosis H37Rv samples (EXIT-RIF / PRJNA1026351), full depth from EBI FTP'

    // ── Input — full-depth FASTQs from EBI FTP ───────────────────────────────
    input    = "${projectDir}/assets/samplesheet_test_full.csv"
    vcf_name = 'test_full'
    outdir   = 'results-test-full'

    // ── Reference genome (bundled H37Rv) ────────────────────────────────────
    // Defaults from nextflow.config are used (resources/genome/NC-000962-3-H37Rv.*)

    // ── Enable all analyses ──────────────────────────────────────────────────
    // With only 3 samples VQSR may fail (insufficient variant diversity).
    // Remove skip_variant_recalibration when testing with ≥20 samples.
    skip_variant_recalibration    = true

    skip_base_recalibration       = true   // standard for Mtb
    skip_minor_variants_gatk      = true   // LoFreq preferred for minor variants

    // Enable optional analyses for a comprehensive full-pipeline test
    skip_tbprofiler_fastq         = false
    skip_spotyping                = false
    skip_rdanalyzer               = true   // experimental — keep off
    skip_ismapper                 = false
    skip_ntmprofiler              = false

    skip_merge_analysis           = false
    skip_phylogeny_and_clustering = false
    skip_complex_regions          = false

    // Standard bootstrap (slower, exercises full IQ-TREE code path)
    iqtree_standard_bootstrap          = true
    iqtree_fast_ml_only                = false
    iqtree_fast_bootstrapped_phylogeny = false
    iqtree_accurate_ml_only            = false
}
