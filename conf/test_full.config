/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Full pipeline test using 3 M. tuberculosis H37Rv samples from EXIT-RIF (PRJNA1026351).
    Enables VQSR optimisation and all downstream analyses (phylogeny, clustering,
    drug resistance profiling, structural variants).

    NOTE: This requires ~30 CPUs and ~64 GB RAM; it is not suitable for laptop/CI runs.
    Use -profile test for a fast minimal check instead.

    Use as follows:
        nextflow run TORCH-consortium/magma -profile test_full,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Full pipeline test: 3 M. tuberculosis H37Rv samples (EXIT-RIF / PRJNA1026351) with all analyses enabled'

    // ── Input ──────────────────────────────────────────────────────────────────
    input              = "${projectDir}/assets/samplesheet_test.csv"
    vcf_name           = 'test_full'
    outdir             = 'results-test-full'

    // ── Reference genome (bundled H37Rv) ───────────────────────────────────────
    // Defaults from nextflow.config are used (resources/genome/NC-000962-3-H37Rv.*)

    // ── Enable all analyses ────────────────────────────────────────────────────
    // NOTE: With only 3 samples VQSR may fail due to insufficient variants.
    // skip_variant_recalibration = true is set as a safety measure; remove on larger cohorts.
    skip_variant_recalibration    = true   // remove when testing with >=20 samples

    skip_base_recalibration       = true   // standard for Mtb
    skip_minor_variants_gatk      = true   // LoFreq preferred
    skip_tbprofiler_fastq         = false  // enable for full test
    skip_spotyping                = false
    skip_rdanalyzer               = true   // experimental — keep off
    skip_ismapper                 = false

    skip_merge_analysis           = false
    skip_phylogeny_and_clustering = false
    skip_complex_regions          = false
    skip_ntmprofiler              = false

    // Standard bootstrap (slower, but tests the full IQ-TREE code path)
    iqtree_standard_bootstrap          = true
    iqtree_fast_ml_only                = false
    iqtree_fast_bootstrapped_phylogeny = false
    iqtree_accurate_ml_only            = false
}
