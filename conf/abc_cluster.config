/*
 * abc_cluster.config — run the nf-core MAGMA port on the abc-cluster platform
 *                      via the nf-nomad executor (HashiCorp Nomad backend).
 *
 *   abc pipeline run https://github.com/abhi18av/magma-nfcore \
 *     --revision main --profile abc_cluster \
 *     --param input_samplesheet=s3://… --param outdir=s3://…
 *
 * Purpose: mirror torch-magma/conf/abc-cluster.config exactly so the per-process
 * commands are IDENTICAL for the bit-identical comparison —
 *   - same container images (same registry refs as conf/docker.config),
 *   - same task.cpus / task.memory (they surface in `-t` / `-Xmx` arguments),
 *   - same DELLY spot-exclusion.
 *
 * abc pipeline run injects executor / workDir / nomad{} / aws{} on top of this,
 * so we do NOT set them here. We also do NOT set docker.enabled: nf-nomad runs
 * each process INSIDE the configured container; `docker run` wrapping would
 * double-wrap and fail (same rationale as conf/docker.config's abc note).
 */

params {
    // S3 outdir can't be symlinked; publish by copy (matches torch-magma save_mode='copy').
    publish_dir_mode = 'copy'
}

process {

    // ── Per-process container images (mirror conf/docker.config) ─────────────
    withName: '.*SPOTYPING.*'  { container = "quay.io/biocontainers/spotyping:2.1--hdfd78af_4" }
    withName: '.*RDANALYZER.*' { container = "quay.io/biocontainers/rd-analyzer:1.01--hdfd78af_0" }
    withName: '.*TBPROFILER.*' { container = "ghcr.io/torch-consortium/magma/biocontainer-tbprofiler:6.3.0--1" }
    withName: 'NTMPROFILER.*'  { container = "ghcr.io/torch-consortium/magma/biocontainer-ntmprofiler:0.4.0" }
    withName: 'ISMAPPER.*|GATK.*|LOFREQ.*|DELLY.*|MULTIQC.*|FASTQC.*|UTILS.*|FASTQ.*|SAMPLESHEET.*' {
        container = "ghcr.io/torch-consortium/magma/magma-container-1:2.0.0"
    }
    withName: 'BWA.*|IQTREE.*|SNPDISTS.*|SNPSITES.*|BCFTOOLS.*|BGZIP.*|SAMTOOLS.*|SNPEFF.*|CLUSTERPICKER.*' {
        container = "ghcr.io/torch-consortium/magma/magma-container-2:1.1.1"
    }

    // ── Resource parity with torch-magma's abc-cluster runs ──────────────────
    // torch-magma default was 4 CPU / 4 GB (nextflow.config process block); cap
    // the nf-core labels to that so other processes (a) fit abc nodes and (b)
    // emit the same thread counts / GATK -Xmx as the reference run.
    withLabel: process_single { cpus = 1; memory = { 4.GB * task.attempt } }
    withLabel: process_low    { cpus = 4; memory = { 4.GB * task.attempt } }
    withLabel: process_medium { cpus = 4; memory = { 4.GB * task.attempt } }
    withLabel: process_high   { cpus = 4; memory = { 4.GB * task.attempt } }

    // Explicit per-process overrides matching torch-magma resource labels so the
    // emitted commands (thread counts, GATK -Xmx) are byte-identical to standard
    // MAGMA. Values mirror torch-magma module labels:
    //   GATK_HAPLOTYPE_CALLER  cpu_4_memory_*   → 4 CPU / 4 GB
    //   BWA_MEM                                  → 4 CPU / 6 GB
    //   GATK_MARK_DUPLICATES                     → 2 CPU / 4 GB
    //   LOFREQ_CALL            cpu_8_memory_4   → 8 CPU / 4 GB  (--pp-threads 8)
    //   GATK_FLAG_STAT         cpu_2_memory_2   → 2 CPU / 2 GB  (-Xmx2G)
    //   GATK_COLLECT_WGS_METRICS cpu_2_memory_2 → 2 CPU / 2 GB  (-Xmx2G)
    withName: '.*GATK_HAPLOTYPE_CALLER.*'      { cpus = 4; memory = { 4.GB * task.attempt } }
    withName: '.*BWA_MEM.*'                    { cpus = 4; memory = { 6.GB * task.attempt } }
    withName: '.*GATK_MARK_DUPLICATES.*'       { cpus = 2; memory = { 4.GB * task.attempt } }
    withName: '.*LOFREQ_CALL.*'                { cpus = 8; memory = { 4.GB * task.attempt } }
    withName: '.*GATK_FLAG_STAT.*'             { cpus = 2; memory = { 2.GB * task.attempt } }
    withName: '.*GATK_COLLECT_WGS_METRICS.*'   { cpus = 2; memory = { 2.GB * task.attempt } }

    // ── Keep DELLY_CALL off preemptible (gcp-spot) nodes ─────────────────────
    // DELLY scans the whole BAM then writes a tiny .bcf; a spot reclaim mid-run
    // wastes a retry. node.class != gcp-spot (same discriminator the platform's
    // Alloy / JuiceFS jobs use). Closure form required for the != operator.
    withName: '.*DELLY_CALL.*' {
        // nf-nomad reads per-process options from the `nomadOptions` directive
        // (NOT `nomad`, which Nextflow rejects as an unknown directive).
        nomadOptions = [ constraints: { node { raw('class', '!=', 'gcp-spot') } } ]
    }

    // Ride Nomad placement timeouts / transient pulls on the same retry budget.
    errorStrategy = { task.attempt < 3 ? 'retry' : 'ignore' }
    maxRetries    = 3
}

executor {
    queueSize = 8
}
