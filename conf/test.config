/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.
    Uses 3 M. tuberculosis H37Rv samples from the EXIT-RIF cohort (PRJNA1026351).

    Use as follows:
        nextflow run TORCH-consortium/magma -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '2.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset: 3 M. tuberculosis H37Rv samples (EXIT-RIF / PRJNA1026351)'

    // ── Input ──────────────────────────────────────────────────────────────────
    input              = "${projectDir}/assets/samplesheet_test.csv"
    magma_vcf_name           = 'test'
    outdir             = 'results-test'

    // ── Reference genome (bundled H37Rv) ───────────────────────────────────────
    // Defaults from nextflow.config are used (resources/genome/NC-000962-3-H37Rv.*)

    // ── Skip slow / resource-heavy analyses for CI ─────────────────────────────
    // VQSR needs many samples; with 3 samples use hard-filter fallback
    magma_skip_variant_recalibration    = true

    // BQSR is off by default for Mtb
    magma_skip_base_recalibration       = true

    // Disable optional analyses that add runtime but not test coverage
    magma_skip_tbprofiler_fastq         = true
    magma_skip_spotyping                = true
    magma_skip_rdanalyzer               = true
    magma_skip_ismapper                 = true

    // Keep per-sample calling and basic cohort analyses
    magma_skip_merge_analysis           = false
    magma_skip_phylogeny_and_clustering = false
    magma_skip_complex_regions          = false
    magma_skip_ntmprofiler              = false
    magma_skip_minor_variants_gatk      = true

    // Use fast ML tree (no bootstrap) to keep test runtime short
    magma_iqtree_standard_bootstrap          = false
    magma_iqtree_fast_ml_only                = true
    magma_iqtree_fast_bootstrapped_phylogeny = false
    magma_iqtree_accurate_ml_only            = false
}
