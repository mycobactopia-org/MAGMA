/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Uses 3 subsampled M. tuberculosis H37Rv samples from the EXIT-RIF cohort
    (PRJNA1026351). Each sample is subsampled to 200,000 read pairs (~13.7x
    coverage of the 4.4 Mb Mtb genome) using fastp, giving a run time of
    ~30-60 min depending on hardware.

    Subsampled FASTQs are hosted on Zenodo. To regenerate them:
        bash scripts/create_test_data.sh

    Use as follows:
        nextflow run TORCH-consortium/magma -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 8,
        memory: '24.GB',
        time: '2.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test: 3 M. tuberculosis H37Rv samples subsampled to 200k read pairs (~13.7x coverage)'

    // ── Input — subsampled FASTQs hosted on Zenodo ────────────────────────────
    // TODO: Replace PLACEHOLDER with the Zenodo record ID after uploading test data.
    //       Run scripts/create_test_data.sh to generate the 6 subsampled FASTQ files,
    //       upload them to a new Zenodo record, then update the URLs in
    //       assets/samplesheet_test.csv.
    input   = "${projectDir}/assets/samplesheet_test.csv"
    vcf_name = 'test'
    outdir   = 'results-test'

    // ── Reference genome (bundled H37Rv) ────────────────────────────────────
    // Defaults from nextflow.config are used (resources/genome/NC-000962-3-H37Rv.*)

    // ── QC thresholds ────────────────────────────────────────────────────────
    // Default cutoff_median_coverage = 10; subsampled data gives ~13.7x, so
    // the default threshold is fine.  No overrides needed.

    // ── Skip slow / resource-heavy analyses ──────────────────────────────────
    // VQSR needs many samples (typically ≥20); use hard-filter fallback
    skip_variant_recalibration    = true

    // BQSR is off by default for Mtb
    skip_base_recalibration       = true

    // Disable optional analyses that add runtime but not CI coverage
    skip_tbprofiler_fastq         = true
    skip_spotyping                = true
    skip_rdanalyzer               = true
    skip_ismapper                 = true
    skip_minor_variants_gatk      = true

    // Keep core analyses: per-sample calling, cohort genotyping, phylogeny
    skip_merge_analysis           = false
    skip_phylogeny_and_clustering = false
    skip_complex_regions          = false
    skip_ntmprofiler              = false

    // Fast ML tree (no bootstrap) to keep test runtime short
    iqtree_standard_bootstrap          = false
    iqtree_fast_ml_only                = true
    iqtree_fast_bootstrapped_phylogeny = false
    iqtree_accurate_ml_only            = false
}
