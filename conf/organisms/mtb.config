/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    M. tuberculosis H37Rv organism profile (explicit defaults)

    These values mirror the pipeline defaults already set in nextflow.config.
    This file is NOT loaded by default — the params block in nextflow.config already
    contains all Mtb-H37Rv defaults.

    Use this file only if you need to explicitly reset back to Mtb after another
    organism profile has been applied (e.g. testing config layering).
    Activate via: nextflow run main.nf -profile <executor>,mtb
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {

    ref_fasta_basename = "NC-000962-3-H37Rv"
    snpeff_genome_id   = "Mycobacterium_tuberculosis_h37rv"

    // For Mtb, the SnpEff DB is pre-installed in the container — no custom config needed.
    // Leave snpeff_config_file empty to use the container's built-in DB.
    snpeff_config_file = ""
    snpeff_db_dir      = ""

    use_ref_gvcf       = true

    rrna_list          = "${projectDir}/resources/regions/rRNA.list"
    excluded_loci_list = "${projectDir}/resources/regions/UVP_List_of_Excluded_loci.list"

    skip_variant_recalibration = false
    skip_spotyping             = true   // default (experimental)
    skip_ntmprofiler           = false
    skip_ismapper              = false

}
