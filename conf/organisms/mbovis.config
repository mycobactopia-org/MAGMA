/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    M. bovis AF2122/97A organism profile
    Activated via: nextflow run main.nf -profile <executor>,mbovis

    Overrides the default Mtb H37Rv parameters with M. bovis-specific reference files,
    disables tools that are not applicable to M. bovis, and skips VQSR (no truth VCF
    available for M. bovis).
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {

    // ─── Reference genome ──────────────────────────────────────────────────────
    // NCBI accession NC_002945v4 (M. bovis AF2122/97A, 4,345,492 bp)
    ref_fasta_basename = "NC_002945v4"

    // ─── SnpEff annotation database ────────────────────────────────────────────
    // Genome ID defined in resources/snpeff/snpEff.config.
    // The DB is built at runtime from resources/snpeff/data/mbovis_AF2122/.
    snpeff_genome_id   = "mbovis_AF2122"
    snpeff_config_file = "${projectDir}/resources/snpeff/snpEff.config"
    snpeff_db_dir      = "${projectDir}/resources/snpeff/data/mbovis_AF2122"

    // ─── Reference GVCF ────────────────────────────────────────────────────────
    // No curated M. bovis lineage GVCF is available.
    // Disable to prevent contamination of the cohort with Mtb reference samples.
    use_ref_gvcf = false

    // ─── Organism-specific resource files ─────────────────────────────────────
    rrna_list          = "${projectDir}/resources/regions/mbovis/rRNA.list"
    excluded_loci_list = "${projectDir}/resources/regions/mbovis/excluded_loci.list"

    // No known-variant VCF available for M. bovis (BQSR is disabled by default anyway)
    dbsnp_vcf     = ""
    dbsnp_vcf_tbi = ""

    // VQSR truth/training VCFs are Mtb-specific; clear them for M. bovis
    benavente2015_vcf     = ""
    benavente2015_vcf_tbi = ""
    coll2014_vcf          = ""
    coll2014_vcf_tbi      = ""
    coll2018_vcf          = ""
    coll2018_vcf_tbi      = ""
    napier2020_vcf        = ""
    napier2020_vcf_tbi    = ""
    walker2015_vcf        = ""
    walker2015_vcf_tbi    = ""
    zeng2018_vcf          = ""
    zeng2018_vcf_tbi      = ""

    // ─── VQSR ─────────────────────────────────────────────────────────────────
    // No curated M. bovis truth VCF set available.
    // Hard-filtering via GATK SelectVariants is applied instead.
    // Set skip_variant_recalibration = false and provide truth VCFs when available.
    skip_variant_recalibration = true

    // ─── Tool skip flags ───────────────────────────────────────────────────────

    // SPATyping performs Mtb-specific spoligotyping; not applicable to M. bovis
    skip_spotyping = true

    // ntm-profiler is not meaningful for MTBC members (M. bovis is MTBC)
    skip_ntmprofiler = true

    // ISMapper: IS900/IS1081 query sequences for M. bovis are not yet assembled.
    // Set skip_ismapper = false and provide queries_multifasta pointing to M. bovis
    // IS element sequences when they become available.
    skip_ismapper = true

}
