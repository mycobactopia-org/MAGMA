/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    TORCH-consortium/MAGMA Nextflow base config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    A 'blank slate' config file, appropriate for general use on most high performance
    compute environments. Assumes that all software is installed and available on
    the PATH. Runs in `local` mode - all jobs will be run on the logged in environment.
----------------------------------------------------------------------------------------
*/

process {

    cpus   = { 1      * task.attempt }
    memory = { 6.GB   * task.attempt }
    time   = { 4.h    * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    // Process-specific resource requirements
    // NOTE - nf-core label naming convention used throughout.
    //        process_single : single-threaded, light memory (utils, scripts, validation)
    //        process_low    : 2-4 CPUs, modest memory (samtools index/stats, simple bcftools)
    //        process_medium : 8 CPUs, 24 GB  (BWA, LoFreq, GATK per-sample, DELLY)
    //        process_high   : 16 CPUs, 72 GB (GATK cohort: CombineGVCFs, VariantRecalibrator)
    //        process_long   : no CPU/memory change, extended walltime (IQTree phylogeny)
    //        process_high_memory : 200 GB (not currently used but kept for compatibility)

    withLabel:process_single {
        cpus   = { 1                   }
        memory = { 6.GB  * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel:process_low {
        cpus   = { 4     * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel:process_medium {
        cpus   = { 8     * task.attempt }
        memory = { 24.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel:process_high {
        cpus   = { 16    * task.attempt }
        memory = { 72.GB * task.attempt }
        time   = { 24.h  * task.attempt }
    }
    withLabel:process_long {
        time   = { 72.h  * task.attempt }
    }
    withLabel:process_high_memory {
        memory = { 200.GB * task.attempt }
    }
    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }
    withLabel: process_gpu {
        ext.use_gpu = { workflow.profile.contains('gpu') }
        accelerator = { workflow.profile.contains('gpu') ? 1 : null }
    }
}
